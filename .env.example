# YouTube Automation Engine Environment Template
# Copy this file to .env and fill in your credentials

# ── LLM / Script Generation ──────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Stock Media APIs ─────────────────────────────────────────────────────
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# ── YouTube Data API v3 OAuth Credentials ────────────────────────────────
# Run `py youtube_auth_setup.py` to generate these automatically
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-your_client_secret_here
YOUTUBE_REFRESH_TOKEN=1//your_oauth_refresh_token_here
